#!/usr/bin/env bash
set -u

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SELF_DIR/runtime.sh"
source "$SELF_DIR/compiler.sh"
source "$SELF_DIR/surface.sh"
source "$SELF_DIR/layout.sh"

usage() {
  cat <<'TXT'
usage:
  blisp run FILE [args...]         # .bl = classic Lisp syntax, .blx/.blh = hybrid syntax
  blisp check FILE                       # parse source/include graph without executing it
  blisp eval EXPR
  blisp evalx EXPR                 # hybrid syntax
  blisp compile FILE [-o OUTPUT]  # auto-detects .blx/.bx
  blisp repl
  blisp replx
TXT
}

load_stdlib_interpreted() {
  local std
  std=$(cat "$SELF_DIR/stdlib.bl") || return
  bl_interpret_source "$std" "$BL_GLOBAL_ENV"
}

is_surface_file() { [[ $1 == *.blx || $1 == *.bx || $1 == *.blh ]]; }

declare -Ag BL_INCLUDE_ACTIVE=() BL_INCLUDE_SEEN=()
declare -ag BL_SOURCE_CHUNKS=() BL_SOURCE_CHUNK_FILES=() BL_SOURCE_CHUNK_LINES=()
BL_SOURCE_REPLY=

# `include` is a top-level source-loader directive, not an expression.  The
# loader is lexical-state aware: directive-shaped text inside strings/comments
# or nested explicit delimiters is ordinary source text and can never trigger a
# file load.  Layout-indented directives are rejected as non-top-level.
#
# Syntax is deliberately narrow and deterministic:
#
#   include "relative/or/absolute/path.blx";
#
# The directive occupies its physical line (apart from whitespace and an
# optional trailing // comment).  Paths resolve relative to the containing
# source file.  Files are included at most once; active recursion is a cycle.
BL_LOAD_DEPTH=0
BL_LOAD_QUOTE=
BL_LOAD_BLOCK_COMMENT=0
BL_INCLUDE_PATH=

bl_loader_scan_line() {
  local line=$1 depth=$2 quote=$3 block=$4 i=0 n=${#1} c d esc=0
  while (( i < n )); do
    c=${line:i:1}; d=${line:i+1:1}
    if (( block )); then
      if [[ $c == '*' && $d == / ]]; then block=0; ((i+=2)) || true; continue; fi
      ((i++)) || true; continue
    fi
    if [[ -n $quote ]]; then
      if (( esc )); then esc=0
      elif [[ $c == \\ ]]; then esc=1
      elif [[ $c == "$quote" ]]; then quote=; fi
      ((i++)) || true; continue
    fi
    if [[ $c == / && $d == / ]]; then break; fi
    if [[ $c == / && $d == '*' ]]; then block=1; ((i+=2)) || true; continue; fi
    if [[ $c == '"' || $c == "'" ]]; then quote=$c; ((i++)) || true; continue; fi
    case $c in
      '('|'['|'{') ((depth++)) || true ;;
      ')'|']'|'}') (( depth > 0 )) && ((depth--)) || true ;;
    esac
    ((i++)) || true
  done
  BL_LOAD_DEPTH=$depth; BL_LOAD_QUOTE=$quote; BL_LOAD_BLOCK_COMMENT=$block
}

# Parse only the source-directive spelling.  Return 0 for a complete directive,
# 1 when the line is not directive-shaped, and 2 for malformed include syntax.
bl_loader_include_line() {
  local line=$1 rest path= out= c i=0 esc=0
  BL_INCLUDE_PATH=
  [[ $line =~ ^include[[:space:]]+ ]] || return 1
  rest=${line#include}; rest=${rest#"${rest%%[![:space:]]*}"}
  [[ ${rest:0:1} == '"' ]] || { echo 'blisp: include path must be a double-quoted string' >&2; return 2; }
  ((i++)) || true
  while (( i < ${#rest} )); do
    c=${rest:i:1}; ((i++)) || true
    if (( esc )); then
      case $c in '"'|\\) out+=$c;; *) echo "blisp: unsupported include path escape \\$c" >&2; return 2;; esac
      esc=0; continue
    fi
    if [[ $c == \\ ]]; then esc=1; continue; fi
    [[ $c == '"' ]] && break
    out+=$c
  done
  [[ $c == '"' ]] && (( ! esc )) || { echo 'blisp: unterminated include path' >&2; return 2; }
  rest=${rest:i}; rest=${rest#"${rest%%[![:space:]]*}"}
  [[ ${rest:0:1} == ';' ]] && { rest=${rest:1}; rest=${rest#"${rest%%[![:space:]]*}"}; }
  [[ -z $rest || $rest == //* ]] || { echo 'blisp: include directive must occupy its source line' >&2; return 2; }
  [[ -n $out ]] || { echo 'blisp: include path may not be empty' >&2; return 2; }
  BL_INCLUDE_PATH=$out
  return 0
}

bl_source_chunk_add() {
  local file=$1 text=$2 line=${3:-1}
  [[ -z $text ]] && return 0
  BL_SOURCE_CHUNKS+=("$text")
  BL_SOURCE_CHUNK_FILES+=("$file")
  BL_SOURCE_CHUNK_LINES+=("$line")
}

# Hybrid files stay as separate ordered chunks for parser performance, but
# source loading itself has language-level semantics independent of chunking.
bl_collect_hybrid_file() {
  local file=$1 abs dir line child buf= depth=0 quote= block=0 indent trimmed st lineno=0 buf_start=1
  abs=$(cd -- "$(dirname -- "$file")" 2>/dev/null && pwd -P)/$(basename -- "$file") || return
  [[ -f $abs ]] || { echo "blisp: include not found: $file" >&2; return 1; }
  [[ ${BL_INCLUDE_ACTIVE[$abs]-0} == 0 ]] || { echo "blisp: include cycle involving $abs" >&2; return 1; }
  [[ ${BL_INCLUDE_SEEN[$abs]-0} == 0 ]] || return 0
  BL_INCLUDE_ACTIVE[$abs]=1; BL_INCLUDE_SEEN[$abs]=1; dir=${abs%/*}

  while IFS= read -r line || [[ -n $line ]]; do
    ((lineno++)) || true
    trimmed=${line#"${line%%[![:space:]]*}"}
    indent=${#line}; indent=$((indent - ${#trimmed}))

    # Only test directive syntax when the line starts in normal lexical state.
    # If it looks like include syntax in a nested/layout context, reject it
    # explicitly rather than letting chunk boundaries define its meaning.
    if [[ -z $quote ]] && (( ! block )) && [[ $trimmed == include[[:space:]]* ]]; then
      if bl_loader_include_line "$trimmed"; then
        if (( depth != 0 || indent != 0 )); then
          echo "blisp: include is top-level only: $abs" >&2
          unset 'BL_INCLUDE_ACTIVE[$abs]'; return 1
        fi
        bl_source_chunk_add "$abs" "$buf" "$buf_start"; buf=
        child=$BL_INCLUDE_PATH; [[ $child == /* ]] || child="$dir/$child"
        bl_collect_hybrid_file "$child" || { unset 'BL_INCLUDE_ACTIVE[$abs]'; return 1; }
        buf_start=$((lineno+1))
        continue
      else
        st=$?
        if (( st == 2 )); then unset 'BL_INCLUDE_ACTIVE[$abs]'; return 1; fi
      fi
    fi

    buf+="$line"$'\n'
    bl_loader_scan_line "$line" "$depth" "$quote" "$block"
    depth=$BL_LOAD_DEPTH; quote=$BL_LOAD_QUOTE; block=$BL_LOAD_BLOCK_COMMENT
  done < "$abs"
  bl_source_chunk_add "$abs" "$buf" "$buf_start"
  unset 'BL_INCLUDE_ACTIVE[$abs]'
}

# Compatibility helper for code that still wants the expanded textual source.
bl_expand_hybrid_file() {
  BL_SOURCE_CHUNKS=(); BL_SOURCE_CHUNK_FILES=(); BL_SOURCE_CHUNK_LINES=(); BL_INCLUDE_ACTIVE=(); BL_INCLUDE_SEEN=()
  bl_collect_hybrid_file "$1" || return
  BL_SOURCE_REPLY=
  local chunk; for chunk in "${BL_SOURCE_CHUNKS[@]}"; do BL_SOURCE_REPLY+="$chunk"$'\n'; done
}

bl_parse_surface_chunks() {
  local -a all=(); local chunk file line_base i
  for ((i=0;i<${#BL_SOURCE_CHUNKS[@]};++i)); do
    chunk=${BL_SOURCE_CHUNKS[i]}; file=${BL_SOURCE_CHUNK_FILES[i]}; line_base=${BL_SOURCE_CHUNK_LINES[i]:-1}
    [[ -z ${chunk//[[:space:]]/} ]] && continue
    bl_parse_surface_all "$chunk" "$file" "$line_base" || return
    all+=("${BL_FORMS[@]}")
  done
  BL_FORMS=("${all[@]}")
}

bl_interpret_surface_chunks() {
  local env=$1 chunk file line_base i
  RET=nil
  for ((i=0;i<${#BL_SOURCE_CHUNKS[@]};++i)); do
    chunk=${BL_SOURCE_CHUNKS[i]}; file=${BL_SOURCE_CHUNK_FILES[i]}; line_base=${BL_SOURCE_CHUNK_LINES[i]:-1}
    [[ -z ${chunk//[[:space:]]/} ]] && continue
    bl_interpret_surface_source "$chunk" "$env" "$file" "$line_base" || return
  done
}

cmd_run() {
  (($# >= 1)) || { usage >&2; return 2; }
  local file=$1; shift
  [[ -f $file ]] || { echo "blisp: no such file: $file" >&2; return 2; }
  bl_runtime_init
  BL_USER_ARGV=("$@")
  load_stdlib_interpreted || return
  local src
  if is_surface_file "$file"; then
    BL_SOURCE_CHUNKS=(); BL_SOURCE_CHUNK_FILES=(); BL_SOURCE_CHUNK_LINES=(); BL_INCLUDE_ACTIVE=(); BL_INCLUDE_SEEN=(); bl_collect_hybrid_file "$file" || return
    bl_interpret_surface_chunks "$BL_GLOBAL_ENV"
  else
    src=$(cat -- "$file") || return; bl_interpret_source "$src" "$BL_GLOBAL_ENV"
  fi
}

cmd_check() {
  (($# == 1)) || { usage >&2; return 2; }
  local file=$1 src
  [[ -f $file ]] || { echo "blisp: no such file: $file" >&2; return 2; }
  bl_runtime_init
  if is_surface_file "$file"; then
    BL_SOURCE_CHUNKS=(); BL_SOURCE_CHUNK_FILES=(); BL_SOURCE_CHUNK_LINES=(); BL_INCLUDE_ACTIVE=(); BL_INCLUDE_SEEN=()
    bl_collect_hybrid_file "$file" || return
    bl_parse_surface_chunks || return
  else
    src=$(cat -- "$file") || return
    bl_parse_all "$src" || return
  fi
  printf 'ok\n'
}

cmd_eval() {
  (($# == 1)) || { usage >&2; return 2; }
  bl_runtime_init
  load_stdlib_interpreted || return
  bl_interpret_source "$1" "$BL_GLOBAL_ENV" || return
  bl_repr "$RET"; printf '\n'
}

cmd_evalx() {
  (($# == 1)) || { usage >&2; return 2; }
  bl_runtime_init
  load_stdlib_interpreted || return
  bl_interpret_surface_source "$1" "$BL_GLOBAL_ENV" '<evalx>' || return
  bl_repr "$RET"; printf '\n'
}

cmd_compile() {
  (($# >= 1)) || { usage >&2; return 2; }
  local file=$1; shift; local out=
  while (($#)); do
    case $1 in
      -o|--output) shift; (($#)) || { echo 'blisp: -o needs a path' >&2; return 2; }; out=$1 ;;
      *) echo "blisp: unknown compile option: $1" >&2; return 2 ;;
    esac
    shift
  done
  [[ -f $file ]] || { echo "blisp: no such file: $file" >&2; return 2; }
  [[ -n $out ]] || { if is_surface_file "$file"; then out=${file%.*}; else out=${file%.bl}; fi; }
  local std src
  std=$(cat "$SELF_DIR/stdlib.bl") || return
  if is_surface_file "$file"; then
    BL_SOURCE_CHUNKS=(); BL_SOURCE_CHUNK_FILES=(); BL_SOURCE_CHUNK_LINES=(); BL_INCLUDE_ACTIVE=(); BL_INCLUDE_SEEN=(); bl_collect_hybrid_file "$file" || return
  else src=$(cat -- "$file") || return; fi
  bl_runtime_init
  if is_surface_file "$file"; then
    bl_parse_all "$std" || return
    local -a std_forms=("${BL_FORMS[@]}")
    bl_parse_surface_chunks || return
    BL_FORMS=("${std_forms[@]}" "${BL_FORMS[@]}")
    bl_compile_forms "$out" "$SELF_DIR/runtime.sh" || return
  else
    bl_compile_source "$std"$'\n'"$src" "$out" "$SELF_DIR/runtime.sh" || return
  fi
  printf '%s\n' "$out"
}

cmd_repl() {
  bl_runtime_init
  load_stdlib_interpreted || return
  local line
  printf 'BLisp REPL. One complete form per line; Ctrl-D exits.\n'
  while IFS= read -r -p 'blisp> ' line; do
    [[ -z $line ]] && continue
    if bl_interpret_source "$line" "$BL_GLOBAL_ENV"; then bl_repr "$RET"; printf '\n'; fi
  done
}

cmd_replx() {
  bl_runtime_init
  load_stdlib_interpreted || return
  local line
  printf 'BLisp hybrid REPL. One statement/expression per line; Ctrl-D exits.\n'
  while IFS= read -r -p 'blx> ' line; do
    [[ -z $line ]] && continue
    if bl_interpret_surface_source "$line" "$BL_GLOBAL_ENV" '<replx>'; then bl_repr "$RET"; printf '\n'; fi
  done
}

main() {
  (($#)) || { usage; return 2; }
  local cmd=$1; shift
  case $cmd in
    run) cmd_run "$@" ;;
    check) cmd_check "$@" ;;
    eval) cmd_eval "$@" ;;
    evalx) cmd_evalx "$@" ;;
    compile) cmd_compile "$@" ;;
    repl) cmd_repl "$@" ;;
    replx) cmd_replx "$@" ;;
    -h|--help|help) usage ;;
    *) echo "blisp: unknown command: $cmd" >&2; usage >&2; return 2 ;;
  esac
}

main "$@"
