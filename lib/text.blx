include "prelude.blx";

fn _textReplace(textValue, old, replacement) {
  if (old == "") throw({kind: :value, message: "replace pattern may not be empty"});
  return textValue.split(old).join(replacement);
}

fn _textPadLeft(s, width, fill = " ") {
  let f = fill;
  if (f.length != 1) throw({kind: :value, message: "padding fill must be one character"});
  let out = s;
  while (out.length < width) out = f + out;
  return out;
}
fn _textPadRight(s, width, fill = " ") {
  let f = fill;
  if (f.length != 1) throw({kind: :value, message: "padding fill must be one character"});
  let out = s;
  while (out.length < width) out += f;
  return out;
}
fn _textIndent(s, prefix) {
  return s.split("\n").map(line => prefix + line).join("\n");
}
fn _textCommonPrefix(values) {
  let xs = toArray(values);
  if (xs.length == 0) return "";
  let p = xs[0];
  for (let i = 1; i < xs.length; i++) {
    while (p != "" and !xs[i].startsWith(p)) p = p.slice(0, p.length - 1);
  }
  return p;
}
fn _textCapitalize(s) {
  return s == "" ? s : s.charAt(0).upper() + s.slice(1).lower();
}
fn _textWrap(s, width) {
  let out = []; let line = "";
  for (let word of s.words()) {
    if (line == "") line = word;
    else if (line.length + 1 + word.length <= width) line += " " + word;
    else { out.push(line); line = word; }
  }
  if (line != "") out.push(line);
  return out;
}


fn _textCodePoints(s) {
  let b = bytes(s); let out=[]; let i=0;
  while (i < b.length) {
    let a=b[i];
    if (a < 0x80) { out.push(a); i++; continue; }
    if ((a & 0xe0) == 0xc0) {
      if (i+1>=b.length) throw({kind::unicode,message:"truncated UTF-8"});
      out.push(((a&31)<<6)|(b[i+1]&63)); i+=2; continue;
    }
    if ((a & 0xf0) == 0xe0) {
      if (i+2>=b.length) throw({kind::unicode,message:"truncated UTF-8"});
      out.push(((a&15)<<12)|((b[i+1]&63)<<6)|(b[i+2]&63)); i+=3; continue;
    }
    if ((a & 0xf8) == 0xf0) {
      if (i+3>=b.length) throw({kind::unicode,message:"truncated UTF-8"});
      out.push(((a&7)<<18)|((b[i+1]&63)<<12)|((b[i+2]&63)<<6)|(b[i+3]&63)); i+=4; continue;
    }
    throw({kind::unicode,message:"invalid UTF-8 leading byte"});
  }
  return out;
}
fn _textCodePoint(s) { let cps=_textCodePoints(s); if(cps.length==0)throw({kind::value,message:"codePoint requires non-empty string"}); return cps[0]; }
fn _textFromCodePoint(cp) {
  cp = int(cp);
  if (cp < 0 or cp > 0x10ffff or (cp >= 0xd800 and cp <= 0xdfff))
    throw({kind: :unicode, message: "invalid Unicode code point"});
  if (cp <= 0x7f) return bytes([cp]).decode();
  if (cp <= 0x7ff) return bytes([0xc0 | (cp >> 6), 0x80 | (cp & 63)]).decode();
  if (cp <= 0xffff) return bytes([0xe0 | (cp >> 12), 0x80 | ((cp >> 6) & 63), 0x80 | (cp & 63)]).decode();
  return bytes([0xf0 | (cp >> 18), 0x80 | ((cp >> 12) & 63), 0x80 | ((cp >> 6) & 63), 0x80 | (cp & 63)]).decode();
}

fn _textFormatInt(value, base = 10) {
  let n = int(value);
  let b = int(base);
  if (b < 2 or b > 36) throw({kind: :value, message: "integer base must be 2..36"});
  if (n == 0) return "0";
  let negative = n < 0;
  if (negative) n = -n;
  let digits = "0123456789abcdefghijklmnopqrstuvwxyz";
  let out = "";
  while (n > 0) {
    out = digits.charAt(n % b) + out;
    n = int(n / b);
  }
  return negative ? "-" + out : out;
}
fn _textParseInt(s, base = 10) {
  let b = int(base);
  if (b < 2 or b > 36) throw({kind: :value, message: "integer base must be 2..36"});
  let raw = s.trim().lower();
  if (raw == "") throw({kind: :value, message: "empty integer text"});
  let sign = 1; let i = 0;
  if (raw.charAt(0) == "-") { sign = -1; i = 1; }
  else if (raw.charAt(0) == "+") i = 1;
  if (i == raw.length) throw({kind: :value, message: "missing integer digits"});
  let digits = "0123456789abcdefghijklmnopqrstuvwxyz";
  let out = 0;
  for (; i < raw.length; i++) {
    let c = raw.charAt(i); let d = digits.indexOf(c);
    if (d < 0 or d >= b) throw({kind: :value, message: "invalid digit for base"});
    out = out * b + d;
  }
  return sign * out;
}

const text = {
  formatInt: _textFormatInt,
  parseInt: _textParseInt,
  replace: _textReplace,
  padLeft: _textPadLeft,
  padRight: _textPadRight,
  indent: _textIndent,
  commonPrefix: _textCommonPrefix,
  capitalize: _textCapitalize,
  wrap: _textWrap,
  codePoint: _textCodePoint,
  codePoints: _textCodePoints,
  chars: fn(s) { return _textCodePoints(s).map(cp => _textFromCodePoint(cp)); },
  fromCodePoint: _textFromCodePoint,
  lines: fn(s) { return s.lines(); },
  words: fn(s) { return s.words(); }
};
