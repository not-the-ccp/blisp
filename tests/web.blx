include "../lib/testing.blx";
include "../lib/web.blx";

let t = testing.suite("web");
let h = web.html;
let css = web.css;
let q = bytes([34]).decode();

fn closeTag(tag) { return "<" + "/" + tag + ">"; }

t.test("HTML text and attribute escaping", fn() {
  testing.equal(h.render(h.p("<&>")), "<p>&lt;&amp;&gt;" + closeTag("p"), null);
  testing.equal(
    h.render(h.input({aria_label: "A&B", disabled: true, required: false, value: q + "x" + q})),
    "<input aria-label=" + q + "A&amp;B" + q + " disabled value=" + q + "&quot;x&quot;" + q + ">",
    null
  );
});

t.test("HTML fragments, arrays, and nil children", fn() {
  let tree = h.div(
    {class: "box"},
    h.h1("Title"),
    [h.p("one"), null, h.p("two")],
    h.fragment(h.span("a"), h.span("b"))
  );
  let expected = "<div class=" + q + "box" + q + "><h1>Title" + closeTag("h1") + "<p>one" + closeTag("p") + "<p>two" + closeTag("p") + "<span>a" + closeTag("span") + "<span>b" + closeTag("span") + closeTag("div");
  testing.equal(h.render(tree), expected, null);
});

t.test("exact attributes and deterministic object shorthand", fn() {
  let attrs = h.attrs(
    {data_test_id: "field"},
    h.attr("for", "email")
  );
  testing.equal(
    h.render(h.label(attrs, "Email")),
    "<label data-test-id=" + q + "field" + q + " for=" + q + "email" + q + ">Email" + closeTag("label"),
    null
  );
});

t.test("HTML rejects structurally invalid values", fn() {
  testing.throws(fn() { h.el("bad tag", "x"); }, :webHtml);
  testing.throws(fn() { h.render(h.input("child")); }, :webHtml);
  testing.throws(fn() { h.render(h.input(h.attrs(h.attr("disabled", true), h.attr("disabled", true)))); }, :webHtml);
});

t.test("explicit unsafe raw HTML is never implicit", fn() {
  let source = "<b>x<" + "/" + "b>";
  let trusted = "<i>trusted<" + "/" + "i>";
  let expected = "<div>&lt;b&gt;x&lt;/b&gt;<i>trusted" + closeTag("i") + closeTag("div");
  testing.equal(h.render(h.div(source, h.unsafeRaw(trusted))), expected, null);
});

t.test("CSS declarations are structured and deterministic", fn() {
  let sheet = css.sheet(
    css.rule("body", {font_family: "system-ui", margin: "0"}),
    css.rule(".card:hover", {transform: "translateY(-2px)"})
  );
  testing.equal(css.render(sheet), "body{font-family:system-ui;margin:0;}.card:hover{transform:translateY(-2px);}", null);
});

t.test("CSS preserves duplicate fallback declarations", fn() {
  let declarations = css.props(
    css.prop("display", "block"),
    css.prop("display", "grid"),
    css.prop("--enabled", false)
  );
  testing.equal(css.render(css.rule(".layout", declarations)), ".layout{display:block;display:grid;--enabled:false;}", null);
});

t.test("CSS exact custom properties and trusted raw escape hatch", fn() {
  let declarations = css.props(
    css.prop("--accent", "#83b"),
    css.prop("background-image", css.raw("url(data:image/svg+xml;base64,abc;def)"))
  );
  testing.equal(css.render(css.rule(":root", declarations)), ":root{--accent:#83b;background-image:url(data:image/svg+xml;base64,abc;def);}", null);
});

t.test("CSS prevents accidental structural breakout", fn() {
  testing.throws(fn() { css.render(css.rule("x", {color: "red;})); }, :webCss);
  testing.throws(fn() { css.rule("x}body", {color: "red"}); }, :webCss);
});

t.test("static page renderer composes the document", fn() {
  let page = web.static.page({
    lang: "en",
    title: "A & B",
    stylesheet: "app.css",
    body: h.main(h.h1("Hello"), h.p("Pure BLisp source"))
  });
  let titleMarkup = "<title>A &amp; B" + closeTag("title");
  let mainMarkup = "<main><h1>Hello" + closeTag("h1") + "<p>Pure BLisp source" + closeTag("p") + closeTag("main");
  testing.equal(page.startsWith("<!doctype html><html "), true, null);
  testing.equal(page.contains(titleMarkup), true, null);
  testing.equal(page.contains("<link "), true, null);
  testing.equal(page.contains("app.css"), true, null);
  testing.equal(page.contains(mainMarkup), true, null);
});

t.report();
