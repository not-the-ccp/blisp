include "../lib/testing.blx";
include "../lib/web.blx";

let t = testing.suite("web-static");
let h = web.html;

fn closeTag(tag) { return "<" + "/" + tag + ">"; }

t.test("page composes a complete document", fn() {
  let page = web.static.page({
    lang: "en",
    title: "A & B",
    stylesheet: "app.css",
    body: h.main(h.h1("Hello"), h.p("Pure BLisp source"))
  });
  let titleMarkup = "<title>A &amp; B" + closeTag("title");
  let mainMarkup = "<main><h1>Hello" + closeTag("h1") + "<p>Pure BLisp source" + closeTag("p") + closeTag("main");
  testing.equal(page.startsWith("<!doctype html><html "), true, null);
  testing.equal(page.contains(titleMarkup), true, null);
  testing.equal(page.contains("<link "), true, null);
  testing.equal(page.contains("app.css"), true, null);
  testing.equal(page.contains(mainMarkup), true, null);
});

t.test("site values preserve declared output files", fn() {
  let site = web.static.site(
    web.static.file("index.html", "page"),
    [web.static.file("assets/app.css", "css")]
  );
  testing.equal(site.__web_static_site, true, null);
  testing.equal(site.files.length, 2, null);
  testing.equal(site.files[0].path, "index.html", null);
  testing.equal(site.files[1].content, "css", null);
});

t.test("site values reject unsafe and duplicate paths", fn() {
  testing.throws(fn() { web.static.file("../index.html", "x"); }, :webStatic);
  testing.throws(fn() { web.static.file("/index.html", "x"); }, :webStatic);
  testing.throws(fn() { web.static.file("assets//app.css", "x"); }, :webStatic);
  testing.throws(fn() {
    web.static.site(web.static.file("index.html", "a"), web.static.file("index.html", "b"));
  }, :webStatic);
});

t.report();
