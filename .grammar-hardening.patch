+  [[ $ht == id ]] || return 1
+  # An S-call requires an actual separator after its head.
+  [[ ${SX_TOK_GAP[next]-0} == 1 ]] || return 1
+  sx_token_continues_grouped_head_at "$next" && return 1
+  [[ ${SX_TOK_VAL[next]-')'} != ')' ]]
+}
