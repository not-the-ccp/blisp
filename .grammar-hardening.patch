+sx_paren_is_sexpr() {
+  local head=$((SX_POS + 1)) next=$((SX_POS + 2))
+  local ht=${SX_TOK_TYPE[head]-eof}
+
+  # Symbolic operators are unambiguous prefix heads when separated from their
